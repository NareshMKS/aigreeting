# Get a key from https://aistudio.google.com/apikey (optional for free mode)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Image generation mode:
#   free   = local canvas only (no API, no billing)
#   gemini = Gemini AI image API only
#   auto   = try Gemini, fall back to free if quota is unavailable (default)
VITE_IMAGE_MODE=auto
